{
  "$schema": "https://opencode.ai/config.json",
  "model": "zhipuai-coding-plan/glm-5.3",
  "instructions": [
    ".specify/memory/constitution.md"
  ],
  "agents": {
    "title": {
      "model": "zhipuai-coding-plan/glm-5.3-flash"
    },
    "build": {
      "model": "zhipuai-coding-plan/glm-5.3",
      "request": {
        "body": {
          "reasoningEffort": "max"
        }
      }
    },
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "request": {
        "body": {
          "reasoningEffort": "max"
        }
      }
    },
    "plan": {
      "model": "zhipuai-coding-plan/glm-5.3",
      "request": {
        "body": {
          "reasoningEffort": "max"
        }
      }
    },
    "general": {
      "model": "zhipuai-coding-plan/glm-5.3",
      "request": {
        "body": {
          "reasoningEffort": "max"
        }
      },
      "permissions": [
        { "action": "todowrite", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "websearch": {
    "provider": "exa"
  },
  "lsp": {
    "bazel": {
      "command": [
        "starpls",
        "server"
      ],
      "extensions": [
        ".bzl",
        ".bazel"
      ]
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "~/.cache/bazel/_bazel_liukexin/*", "effect": "allow" }
  ]
}
