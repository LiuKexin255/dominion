{
  "$schema": "https://opencode.ai/config.json",
  "model": "zhipuai-coding-plan/glm-5.2",
  "small_model": "opencode-go/deepseek-v4-flash",
  "instructions": [
    ".specify/memory/constitution.md"
  ],
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4-flash",
      "reasoningEffort": "max"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "reasoningEffort": "max"
    },
    "plan": {
      "model": "zhipuai-coding-plan/glm-5.2",
      "reasoningEffort": "max",
    },
    "general": {
      "model": "zhipuai-coding-plan/glm-5.2",
      "reasoningEffort": "max",
      "tools": {
        "todowrite": true
      }
    },
  },
  "lsp": {
    "bazel": {
      "command": [
        "starpls",
        "server"
      ],
      "extensions": [
        ".bzl",
        ".bazel"
      ]
    }
  },
  "permission": {
    "read": {
      "~/.cache/bazel/_bazel_liukexin/**/*": "allow"
    }
  }
}