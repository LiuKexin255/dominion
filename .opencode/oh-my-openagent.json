{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "opencode-go/kimi-k2.7-code"
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    },
    "oracle": {
      "model": "zhipuai-coding-plan/glm-5.2"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "high"
    },
    "librarian": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "high"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    },
    "prometheus": {
      "model": "zhipuai-coding-plan/glm-5.2",
      "prompt_append": "Read `constitution.md` before you generate any documents. With one exception, you can edit the 'specs' directory when necessary for those who use the spec-kit as an sdd framework. During the design, the requirements of the construction for the plan and task should also be followed. The tasks of the OMO plan also need to comply with the requirements of the SDD specification. After the completion of the plan, the review should also include the inspection required by the construction."
    },
    "metis": {
      "model": "zhipuai-coding-plan/glm-5.2"
    },
    "momus": {
      "model": "opencode-go/deepseek-v4-pro",
      "variant": "max"
    },
    "atlas": {
      "model": "zhipuai-coding-plan/glm-5.2",
      "prompt_append": "In the planning, the specific reference documents for each task should not be omitted or summarized."
    },
    "sisyphus-junior": {
      "model": "zhipuai-coding-plan/glm-5.2"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "zhipuai-coding-plan/glm-5.2"
    },
    "ultrabrain": {
      "model": "zhipuai-coding-plan/glm-5.2"
    },
    "artistry": {
      "model": "zhipuai-coding-plan/glm-5.2"
    },
    "deep": {
      "model": "zhipuai-coding-plan/glm-5.2"
    },
    "quick": {
      "model": "opencode-go/kimi-k2.7-code"
    },
    "unspecified-low": {
      "model": "opencode-go/kimi-k2.7-code"
    },
    "unspecified-high": {
      "model": "zhipuai-coding-plan/glm-5.2"
    },
    "writing": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "medium"
    }
  },
  "disabled_hooks": [
    "prometheus-md-only",
    "comment-checker"
  ]
}