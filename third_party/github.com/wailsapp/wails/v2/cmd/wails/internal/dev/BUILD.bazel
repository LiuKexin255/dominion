load("@rules_go//go:def.bzl", "go_library")
load("//tools/dev/go:defs.bzl", "go_unittest")

go_library(
    name = "dev",
    srcs = [
        "dev.go",
        "dev_other.go",
        "dev_windows.go",
        "stdout_scanner.go",
        "watcher.go",
    ],
    importpath = "github.com/wailsapp/wails/v2/cmd/wails/internal/dev",
    visibility = ["//third_party/github.com/wailsapp/wails/v2/cmd/wails:__subpackages__"],
    deps = [
        "//third_party/github.com/wailsapp/wails/v2/cmd/wails/flags",
        "//third_party/github.com/wailsapp/wails/v2/cmd/wails/internal/gomod",
        "//third_party/github.com/wailsapp/wails/v2/cmd/wails/internal/logutils",
        "//third_party/github.com/wailsapp/wails/v2/internal/fs",
        "//third_party/github.com/wailsapp/wails/v2/internal/process",
        "//third_party/github.com/wailsapp/wails/v2/pkg/clilogger",
        "//third_party/github.com/wailsapp/wails/v2/pkg/commands/build",
        "//third_party/github.com/wailsapp/wails/v2/pkg/commands/buildtags",
        "@com_github_acarl005_stripansi//:stripansi",
        "@com_github_fsnotify_fsnotify//:fsnotify",
        "@com_github_google_shlex//:shlex",
        "@com_github_pkg_browser//:browser",
        "@com_github_sabhiram_go_gitignore//:go-gitignore",
        "@com_github_samber_lo//:lo",
        "@org_golang_x_mod//semver",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:ios": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_unittest(
    name = "dev_test",
    srcs = ["watcher_test.go"],
    embed = [":dev"],
    deps = [
        "//third_party/github.com/wailsapp/wails/v2/internal/fs",
        "@com_github_samber_lo//:lo",
        "@com_github_stretchr_testify//require",
    ],
)
