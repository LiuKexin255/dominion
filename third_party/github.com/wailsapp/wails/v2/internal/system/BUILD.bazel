        "system_windows.go",
    ],
    importpath = "github.com/wailsapp/wails/v2/internal/system",
    visibility = ["//third_party/github.com/wailsapp/wails/v2:__subpackages__"],
    deps = [
        "//third_party/github.com/wailsapp/wails/v2/internal/shell",
        "//third_party/github.com/wailsapp/wails/v2/internal/system/operatingsystem",
        "//third_party/github.com/wailsapp/wails/v2/internal/system/packagemanager",
    ] + select({
        "@rules_go//go/platform:windows": [
