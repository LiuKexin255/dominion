load("@rules_go//go:def.bzl", "go_library")
load("//tools/dev/go:defs.bzl", "go_unittest")

go_library(
    name = "github",
    srcs = [
        "github.go",
        "semver.go",
    ],
    importpath = "github.com/wailsapp/wails/v2/internal/github",
    visibility = ["//third_party/github.com/wailsapp/wails/v2:__subpackages__"],
    deps = [
        "@com_github_charmbracelet_glamour//:glamour",
        "@com_github_charmbracelet_glamour//styles",
        "@com_github_masterminds_semver//:semver",
    ],
)

go_unittest(
    name = "github_test",
    srcs = ["semver_test.go"],
    embed = [":github"],
    deps = ["@com_github_matryer_is//:is"],
)
