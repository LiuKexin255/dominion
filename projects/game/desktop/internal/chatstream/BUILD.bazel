load("@rules_go//go:def.bzl", "go_library")
load("//tools/dev/go:defs.bzl", "go_unittest")

go_library(
    name = "chatstream",
    srcs = [
        "chunk.go",
        "server.go",
        "stream.go",
    ],
    importpath = "dominion/projects/game/desktop/internal/chatstream",
    visibility = ["//projects/game/desktop:__subpackages__"],
