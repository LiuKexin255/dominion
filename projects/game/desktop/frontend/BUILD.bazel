load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:vite.bzl", "vite_build")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")

npm_link_all_packages(name = "node_modules")

vite_build(
    name = "dist",
    srcs = glob(["src/**"]),
    config = "vite.config.ts",
    index_html = "index.html",
    package_json = "package.json",
    svelte_config = "svelte.config.js",
    tsconfig = "tsconfig.json",
    visibility = ["//visibility:public"],
)

# Component tests via the shared vitest shim (style/javascript.md §测试).
# data mirrors the full set of inputs the tests need at runtime: the raw .ts
# sources (production + tests) plus the test-stack node_modules — a missing
# entry crashes in runfiles with `Cannot find package`. jsdom backs the
# `// @vitest-environment jsdom` docblock in App.test.ts; svelte + the svelte
# vite plugin make App.svelte transformable inside the vitest pipeline (the
# js_test cwd is the runfiles workspace root, where no vite/vitest config
# exists, so VITEST_VITE_OVERRIDES pins the vite root to this package so
# vitest discovers the package vite.config.ts / svelte.config.js — the same
# shim opt-in the web frontend consumes, tools/dev/js/run_vitest.mjs).
# :node_modules/vitest is auto-injected by the macro; do not add it here.
vitest_test(
    name = "lib_test",
    size = "small",
    data = glob(
        [
            "src/**/*.ts",
            "src/**/*.svelte",
        ],
        allow_empty = True,
    ) + [
        "package.json",
        "svelte.config.js",
        "vite.config.ts",
        ":node_modules/@sveltejs/vite-plugin-svelte",
        ":node_modules/jsdom",
        ":node_modules/svelte",
    ],
    env = {
        # - root: the js_test cwd is the runfiles workspace root, so pin the
        #   vite root to this package for vitest to discover the package
        #   vite.config.ts / svelte.config.js.
        # - resolve.conditions: the vite dev-client default set — vitest's SSR
        #   resolver otherwise picks svelte's node entry (index-server.js),
        #   where mount() is unavailable for the jsdom component tests.
        "VITEST_VITE_OVERRIDES": '{"root":"projects/game/desktop/frontend","resolve":{"conditions":["module","browser","development|production"]}}',
    },
)
