vitest_test(
    name = "lib_test",
    size = "small",
    # Fix B: test against the package's raw .ts source (NOT the compiled :lib).
    # vitest transforms the whole package through one Vite pipeline so production
    # code and tests share one module instance (instanceof/singletons behave as
    # in the CLI). The node_modules mirror the :lib deps (dropping :lib removed
    # their transitive runfiles carry-in); external npm packages have no .ts
    # source in runfiles, so adding them does NOT re-create the dual instance.
    # :game_types_lib is NOT needed — agent source imports it via `import type`
    # only (erased at runtime). See vitest_test.bzl docstring + research.md §6.
    data = glob(
        ["src/**/*.ts"],
        allow_empty = True,
    ) + [
        # skill-loader.ts reads src/skill/saolei/SKILL.md at runtime via
        # fs.readFileSync (research.md D9 — skill body bundled into the
        # image). The .md must be in the test runfiles so the skill-loader
        # tests exercise the real read path.
        "src/skill/memory/SKILL.md",
        "src/skill/saolei/SKILL.md",
        ":node_modules/@dominion/common-js-grpc-otel",
        ":node_modules/@dominion/common-js-grpc-resolver",
        ":node_modules/@dominion/common-js-logs",
        ":node_modules/@dominion/common-js-otel",
        ":node_modules/@dominion/common-js-resolver",
        ":node_modules/@dominion/game-saolei-board",
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
        ":node_modules/@langchain/anthropic",
        ":node_modules/@langchain/core",
        ":node_modules/@langchain/langgraph",
        ":node_modules/@langchain/mcp-adapters",
        ":node_modules/@langchain/openai",
        ":node_modules/@modelcontextprotocol/sdk",
        ":node_modules/@types/express",
        ":node_modules/@types/node",
        ":node_modules/express",
        ":node_modules/langchain",
        ":node_modules/mongodb",
        ":node_modules/zod",
    ],
)
