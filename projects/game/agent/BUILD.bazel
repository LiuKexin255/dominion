load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:ts_proto_library.bzl", "ts_proto_library")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")
load("//tools/release:defs.bzl", "artifact_image", "artifact_pkg_js")

npm_link_all_packages(name = "node_modules")

ts_proto_library(
    name = "game_types",
    proto = "//projects/game:game_proto",
    visibility = ["//visibility:public"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["**/*.test.ts"],
    ),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig.json",
    visibility = ["//visibility:public"],
    deps = [
        ":game_types_lib",
        ":node_modules/@dominion/common-js-grpc-otel",
        ":node_modules/@dominion/common-js-grpc-resolver",
        ":node_modules/@dominion/common-js-logs",
        ":node_modules/@dominion/common-js-otel",
        ":node_modules/@dominion/common-js-resolver",
        ":node_modules/@dominion/game-saolei-board",
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
        ":node_modules/@langchain/anthropic",
        ":node_modules/@langchain/core",
        ":node_modules/@langchain/langgraph",
        ":node_modules/@langchain/mcp-adapters",
        ":node_modules/@langchain/openai",
        ":node_modules/@modelcontextprotocol/sdk",
        ":node_modules/@types/express",
        ":node_modules/@types/node",
        ":node_modules/express",
        ":node_modules/langchain",
        ":node_modules/mongodb",
        ":node_modules/zod",
    ],
)

js_library(
    name = "game_types_lib",
    srcs = [":game_types"],
)

# Package JS service files into a tar layer
artifact_pkg_js(
    name = "server_pkg",
    app = "game",
    data_files = [
        "src/skill/memory/SKILL.md",
        "src/skill/saolei/SKILL.md",
    ],
    entrypoint = "src/bootstrap.js",
    npm_deps = [
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
        ":node_modules/@langchain/anthropic",
        ":node_modules/@langchain/core",
        ":node_modules/@langchain/langgraph",
        ":node_modules/@langchain/mcp-adapters",
        ":node_modules/@langchain/openai",
        ":node_modules/@modelcontextprotocol/sdk",
        ":node_modules/express",
        ":node_modules/langchain",
        ":node_modules/mongodb",
        ":node_modules/zod",
    ],
    runtime_protos = [
        "//projects/game:game_proto",
    ],
    service = "agent",
    ts_project = ":lib",
    runtime_deps = [
        "//common/js/grpc/otel:runtime_pkg",
        "//common/js/grpc/resolver:runtime_pkg",
        "//common/js/logs:runtime_pkg",
        "//common/js/otel:runtime_pkg",
        "//projects/game/pkg/saolei-board:runtime_pkg",
    ],
)

# OCI image for the TypeScript game agent
artifact_image(
    name = "cmd_image",
    app = "game",
    pkg = ":server_pkg",
    service = "agent",
    visibility = ["//visibility:public"],
)

