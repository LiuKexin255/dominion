load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")
load("//tools/release:js_runtime_library.bzl", "js_runtime_library")

npm_link_all_packages(name = "node_modules")

# tsc type-checks the bin-tree copies of srcs; the nearest package.json for
# format detection must therefore also be a bin-tree input declaring
# "type": "module" (NodeNext per-file ESM detection), hence the deps entry.
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["package.json"],
)

# gazelle:exclude src/core/test-helpers.ts

# ── Core library ────────────────────────────────────────────────────────────
# The importable package (@dominion/game-saolei-board). External consumers
# depend on :core and import the core barrel (src/core/index.ts). The CLI is a
# separate target (:cli) that depends on this package by name.

ts_project(
    name = "core",
    srcs = glob(
        ["src/core/**/*.ts"],
        exclude = [
            "**/*.test.ts",
            "src/core/test-helpers.ts",
        ],
    ),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@types/node",
        ":node_modules/@types/pngjs",
        ":node_modules/pngjs",
    ],
)

# Workspace package target: gives :core the package name so
# `@dominion/game-saolei-board` resolves via npm_link_all_packages (the same
# pattern common/js packages use — see common/js/logs/BUILD.bazel).
js_library(
    name = "pkg",
    srcs = [
        "package.json",
        ":core",
    ],
    visibility = ["//visibility:public"],
)

# Runtime package target exposing JsRuntimePackageInfo for artifact_pkg_js
# runtime_deps closure walking (see common/js/logs/BUILD.bazel :runtime_pkg and
# tools/release/js_runtime_library.bzl). Required so a consuming service's
# artifact_pkg_js packages THIS package's own compiled source (Phase 4 of
# _artifact_pkg_js_impl) plus its third-party runtime dep pngjs (collected into
# the closure's npm_targets). Separate from :pkg because the npm_deps Phase 3
# path of artifact_pkg_js only copies files whose short_path contains
# "node_modules/" — a workspace package's own source lives at
# projects/game/pkg/saolei-board/src/core/*.js and would be skipped without
# this JsRuntimePackageInfo provider.
js_runtime_library(
    name = "runtime_pkg",
    package_name = "@dominion/game-saolei-board",
    lib = ":core",
    npm_deps = [
        ":node_modules/pngjs",
    ],
    package_json = "package.json",
    visibility = ["//visibility:public"],
    runtime_deps = [],
)

# ── CLI shell ───────────────────────────────────────────────────────────────
# `bazel run //projects/game/pkg/saolei-board:cli -- <screenshot.png>`.
# A thin shell over the core library; imports @dominion/game-saolei-board so it
# stays decoupled from the core's internal layout.

ts_project(
    name = "cli_lib",
    srcs = ["src/cli/cli.ts"],
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":core",
        ":node_modules/@types/node",
    ],
)

js_binary(
    name = "cli",
    data = [
        # package.json must sit at the package root in runfiles so Node's
        # nearest-package.json lookup resolves src/cli/cli.js as ESM
        # ("type": "module") — contract §4,
        # specs/048-js-esm-migration/contracts/esm-package-conventions.md.
        "package.json",
        ":cli_lib",
        ":core",
    ],
    entry_point = "src/cli/cli.js",
    visibility = ["//visibility:public"],
)

# ── Tests ───────────────────────────────────────────────────────────────────
vitest_test(
    name = "lib_test",
    size = "small",
    # Test against the package's raw .ts source (NOT the compiled :core), per
    # style/javascript.md §js_test 执行模型 and the vitest_test macro contract.
    data = glob(
        ["src/core/**/*.ts"],
        allow_empty = True,
    ) + glob(["testdata/*.png"]) + glob(["testdata/*.golden.txt"]) + [
        ":node_modules/@types/node",
        ":node_modules/@types/pngjs",
        ":node_modules/pngjs",
    ],
)
