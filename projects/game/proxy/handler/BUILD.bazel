load("@rules_go//go:def.bzl", "go_library")
load("//tools/dev/go:defs.bzl", "go_unittest")

go_library(
    name = "handler",
    srcs = ["handler.go"],
    importpath = "dominion/projects/game/proxy/handler",
    visibility = ["//visibility:public"],
    deps = [
        "//common/gopkg/logs",
        "//common/gopkg/logs/event",
        "//projects/game",
        "//projects/game/proxy/domain",
        "//projects/game/proxy/runtime/agentclient",
