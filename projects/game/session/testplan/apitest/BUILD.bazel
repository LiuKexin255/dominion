load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/release:defs.bzl", "artifact_image")

go_library(
    name = "apitest_lib",
    srcs = ["main.go"],
    importpath = "dominion/projects/game/session/testplan/apitest",
    visibility = ["//visibility:private"],
    deps = [
        "//common/gopkg/bootstrap",
        "//common/gopkg/grpc",
        "//common/gopkg/grpc/solver",
        "//common/gopkg/otel",
        "//projects/game/pkg/const",
        "//projects/game/session",
        "@grpc_ecosystem_grpc_gateway//runtime",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "apitest",
    embed = [":apitest_lib"],
    visibility = ["//visibility:public"],
)

artifact_image(
    name = "cmd_image",
    app = "game",
    binary = ":apitest",
    service = "session-apitest",
)
