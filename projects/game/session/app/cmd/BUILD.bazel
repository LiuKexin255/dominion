load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/release:defs.bzl", "artifact_image")

go_library(
    name = "cmd_lib",
    srcs = ["main.go"],
    importpath = "dominion/projects/game/session/app/cmd",
    visibility = ["//visibility:private"],
    deps = [
        "//common/gopkg/bootstrap",
        "//common/gopkg/grpc",
        "//common/gopkg/mongo",
        "//common/gopkg/otel",
        "//projects/game/pkg/const",
        "//projects/game/session",
        "//projects/game/session/runtime/runtimeclient",
        "//projects/game/session/runtime/storage",
        "//projects/game/session/service",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "cmd",
    embed = [":cmd_lib"],
    visibility = ["//visibility:public"],
)

artifact_image(
    name = "cmd_image",
    app = "game",
    binary = ":cmd",
    service = "session",
)
