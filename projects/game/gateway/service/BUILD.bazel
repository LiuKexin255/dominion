load("@rules_go//go:def.bzl", "go_library")
load("//tools/dev/go:defs.bzl", "go_unittest")

go_library(
    name = "service",
    srcs = [
        "control.go",
        "gateway.go",
        "worker.go",
    ],
    importpath = "dominion/projects/game/gateway/service",
    visibility = ["//visibility:public"],
    deps = [
        "//common/gopkg/bootstrap",
        "//common/gopkg/logs",
        "//common/gopkg/logs/event",
        "//common/gopkg/otel",
        "//projects/game/gateway/config",
        "//projects/game/gateway/domain",
        "//projects/game/gateway/domain/mediacache",
        "//projects/game/gateway/domain/sessionmanager",
        "//projects/game/gateway/token",
    ],
)

go_unittest(
    name = "service_test",
    srcs = [
        "control_test.go",
        "gateway_test.go",
    ],
    embed = [":service"],
    deps = [
        "//projects/game/gateway/config",
        "//projects/game/gateway/domain",
        "//projects/game/gateway/domain/sessionmanager",
        "//projects/game/gateway/token",
    ],
)
