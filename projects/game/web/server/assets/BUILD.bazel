load("//tools/release/wails:defs.bzl", "wails_asset_library")

# Lives in its own BUILD package (mirroring projects/game/desktop/assets/ and
# experimental/js/vite_react_demo/server/assets/) because //go:embed patterns
# cannot contain ".." (https://pkg.go.dev/embed): the cross-package dist tree
# artifact must be staged into the embed library's own directory, and gazelle
# resolves the import from the importpath that matches this physical directory
# (specs/050-vite-react-bazel/research.md D8).
wails_asset_library(
    name = "assets",
    src = "//projects/game/web/frontend:dist",
    importpath = "dominion/projects/game/web/server/assets",
    visibility = ["//projects/game/web/server:__pkg__"],
)
