# memory_test is the MEMORY module large-test suite (spec
# 039-planner-memory-calibration US2 — FR-006..FR-012/FR-018/FR-020):
# TestMemoryServiceHttpCrudAndPagination (MemoryService CRUD + AIP-158
# pagination through the gateway public entry) and TestPlannerMemoryToolFlow
# (the game-driven planner `memory` tool chain — hermes-style args, agent
# conversion persistence, old_text 0-hit/multi-hit error feedback). It reuses
# the shared helpers (helpers_test.go — setupTeamSession / playTeamGameUntilWait
# / the memory HTTP helpers) and the saolei board fixtures, and drives games
# through the saolei TEAM graph exactly like the saolei-team suite.
# size = small: two game-driving tests + HTTP CRUD, well within the small
# budget (the 6-game compression test alone is what pushed testplan_test to
# medium).
go_largetest(
    name = "memory_test",
    size = "small",
    srcs = [
        "helpers_test.go",
        "memory_test.go",
        "saolei_fixtures_test.go",
    ],
    embedsrcs = SAOLEI_EMBEDSRCS,
    deps = [
        "//common/gopkg/testtool",
        "//projects/game",
        "//projects/game/pkg/gameconst",
        TRACECONTEXT_DEP,
        "@com_github_gorilla_websocket//:websocket",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

# testplan_test is the saolei template TEAM suite (spec
# 031-team-template-mode quickstart.md §2.1 / tasks.md Phase 8 T029): team
# lifecycle, TeamProfile CRUD, per-TeamProfile model, player-exclusive
# control, planner-trigger-per-game, planner long-term memory persistence +
# the calibration instruction scenarios (spec 039-planner-memory-calibration
# FR-014..FR-019), RefreshTeam, and per-agent message partitioning. It
# replaces the removed prompt / session-agent-lifecycle / per-profile-model
# suites. The target uses the gazelle default name ({package_name}_test) so
# gazelle does not regenerate a go_unittest (style/large_test.md).
#
# size = medium: the 037 optimize suite (specs/037-saolei-team-optimize
# FR-034) added TestTeamCompressionAtFiveGames, which drives 6 full games on
# one session (4 pre-compression + the compression game + a post-compression
# resume game) — beyond the 60s "small" budget alongside the other
# game-driving tests (style/large_test.md §测试用例: size per actual need).
go_largetest(
    name = "testplan_test",
    size = "medium",
    srcs = [
        "helpers_test.go",
        "saolei_fixtures_test.go",
        "saolei_team_test.go",
    ],
    embedsrcs = SAOLEI_EMBEDSRCS,
    deps = [
        "//common/gopkg/testtool",
        "//projects/game",
        "//projects/game/pkg/gameconst",
        TRACECONTEXT_DEP,
        "@com_github_gorilla_websocket//:websocket",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

# agent_stall_test is the stream-stall recovery suite (specs/043-llm-stream-
# stall-recovery — T011 large test), run against the stall deploy
# (deploy_agent_stall.yaml — GAME_STREAM_IDLE_TIMEOUT_MS=15000, FR-001's
# 15s minimum):
#   - TestAgentStallRecoveryWithQueuedMessage (US1/US2, quickstart
#     Scenario 5): a fake-llm turn that emits its reasoning delta then
#     stops with the connection alive (sample_stall.yaml) is detected
#     within the idle window — warn + wait emitted, the queued message
#     RETAINED (no QueueSignal(0), FR-006) and delivered on the next turn
#     (FR-007).
#   - TestAgentStallToolExecutionNotFalselyDetected (US3, Scenario 6): a
#     saolei_operate dispatch delayed > 20s (> idleTimeout) on the
#     production saolei MCP path does not false-stall — the client-side
#     heartbeat wrapper keeps the idle timer alive (FR-003/SC-003).
#
# size = medium: both tests sleep past the 15s idle timeout (15s stall
# window / 20s tool delay), beyond the 60s "small" budget
# (style/large_test.md §测试用例: size per actual need).
go_largetest(
    name = "agent_stall_test",
    size = "medium",
    srcs = [
        "agent_stall_test.go",
        "helpers_test.go",
        "saolei_fixtures_test.go",
    ],
    embedsrcs = SAOLEI_EMBEDSRCS,
    deps = [
        "//common/gopkg/testtool",
        "//projects/game",
        "//projects/game/pkg/gameconst",
        TRACECONTEXT_DEP,
        "@com_github_gorilla_websocket//:websocket",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)
