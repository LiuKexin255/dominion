# Shares the agent_v2 helpers and the saolei fixtures like agent_v2_game_test.
#
# size = medium: the case waits out the fake-desktop's reconnect cycle
# between its games and drives three full game chains
# (style/large_test.md §测试用例).
go_largetest(
    name = "agent_v2_game_disconnect_test",
    size = "medium",
    srcs = [
        "agent_v2_game_disconnect_test.go",
        "agent_v2_helpers_test.go",
        "helpers_test.go",
        "saolei_fixtures_test.go",
