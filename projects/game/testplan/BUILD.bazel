# agent_v2_conversation_test is the team conversation suite
# (specs/059-agent-v2-team-mode — quickstart V3/V6): the static wait and first
# user drive, the member-labelled team stream with the team_message seq
# anchor, member-view relays, the queued-message digest priority, cancel
# pause/resume, refresh with in-flight termination + queue void + memory
# clear, the per-member streamed/error/interrupted turns, request-level
# rejections, and concurrent session isolation — all over the gateway /api/v2
# NDJSON surface with the fake /v1/responses endpoint. It reuses the agent_v2
# team helpers (agent_v2_helpers_test.go — the /api/v2 team client + stream
# invariant checker) and the shared HTTP helpers (helpers_test.go).
#
# size = medium: the queued and dispose cases each burn a ~3s slow-template
# window and the isolation case runs two of them concurrently, while every
# case drives a fresh session through the gateway→proxy→agent_v2 chain —
# small's 60s budget leaves too little headroom for the dsh get-or-create
# latency (style/large_test.md §测试用例: size per actual need).
go_largetest(
    name = "agent_v2_conversation_test",
    size = "medium",
    srcs = [
        "agent_v2_conversation_test.go",
        "agent_v2_helpers_test.go",
        "helpers_test.go",
        # The shared agent_v2 helpers now stage flow receipts (the
        # desktop-flow/game suites' serveWonInitReceipt), which consume the
        # embedded board fixtures — the shared-fixture file travels with the
        # helper set (style/large_test.md §反模式3).
        "saolei_fixtures_test.go",
    ],
    embedsrcs = SAOLEI_EMBEDSRCS,
    deps = [
        "//common/gopkg/testtool",
        "//projects/game",
        "//projects/game/pkg/gameconst",
        TRACECONTEXT_DEP,
        "@com_github_gorilla_websocket//:websocket",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

