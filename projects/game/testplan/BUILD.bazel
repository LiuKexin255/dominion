load("//tools/dev/go:defs.bzl", "go_largetest")

# saolei_fixtures_test.go embeds real Minesweeper screenshots reused from the
# @dominion/game-saolei-board golden testdata (declared in
# saolei_fixtures_test.go). The deployed agent runs the real recognition
# engine (no DI seam), so the FlowResultPart.screenshot the test attaches
# MUST be a recognizable board; the embedded PNGs are the authoritative bytes
# owned by the saolei-board package (golden-tested). The fixtures span every
# game outcome (specs/027-chat-bubble-game-state/research.md D12;
# specs/028-saolei-win-counter-fix): in-progress (saolei_1.png 16×16
# all-INITIAL, saolei_2.png 9×9 partially revealed), a same-game
# in-progress→win pair (saolei_8.png 9×9 all-INITIAL with 6 flags →
# saolei_10.png 9×9 win board, counter 000 — the team terminal-win flow of
# specs/059-agent-v2-team-mode/tasks.md T018), loss (saolei_5.png 16×16 with
# HIT_MINE/MINE), and the over-flag false-positive (saolei_9.png 9×9 grid
# all-revealed with 11 flags, counter -01 — spec 028). Each is a cmp-identical
# copy of its library-original, mirroring the saolei_1/saolei_2 precedent.
SAOLEI_FIXTURES = [
    "saolei_fixtures_test.go",
]

SAOLEI_EMBEDSRCS = [
    "testdata/saolei_1.png",
    "testdata/saolei_2.png",
    "testdata/saolei_8.png",
    "testdata/saolei_10.png",
    "testdata/saolei_5.png",
    "testdata/saolei_9.png",
]

# TRACECONTEXT_DEP is required by helpers_test.go (traceContext /
# doHTTPTrace — style/large_test.md §测试用例: set and print trace_id via
# common/gopkg/otel/tracecontext).
TRACECONTEXT_DEP = "//common/gopkg/otel/tracecontext"

# testplan_test is the SESSION module large-test suite: session CRUD and
# ListSessions pagination over the /api/v1 session face
# (templates/saolei/sessions/...). It reuses the shared HTTP helpers
# (helpers_test.go).
#
# The target carries the gazelle default name ({package_name}_test — the
# package is `testplan`): with no default-named test target in the
# directory, gazelle regenerates a duplicate go_unittest gathering every
# *_test.go file (verified empirically; style/large_test.md §测试用例).
#
# size = small: direct session CRUD round trips only.
go_largetest(
    name = "testplan_test",
    size = "small",
    srcs = [
        "helpers_test.go",
        "session_test.go",
    ],
    deps = [
        "//common/gopkg/testtool",
        "//projects/game",
        "//projects/game/pkg/gameconst",
        TRACECONTEXT_DEP,
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

