# agent_saolei_test embeds real Minesweeper screenshots
# (testdata/saolei_1.png, testdata/saolei_2.png) reused from the
# @dominion/game-saolei-board golden testdata. The deployed agent runs the
# real recognition engine (no DI seam), so the FlowResultPart.screenshot the
# test attaches MUST be a recognizable board; the embedded PNGs are the
# authoritative bytes owned by the saolei-board package (golden-tested).
go_largetest(
    name = "agent_saolei_test",
    size = "small",
    srcs = [
        "agent_saolei_test.go",
        "helpers_test.go",
    ],
    embedsrcs = [
        "testdata/saolei_1.png",
        "testdata/saolei_2.png",
    ],
    deps = [
        "//common/gopkg/testtool",
        "//projects/game",
        "//projects/game/pkg/gameconst",
        "@com_github_gorilla_websocket//:websocket",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)
