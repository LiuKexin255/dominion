load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:ts_proto_library.bzl", "ts_proto_library")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")
load("//tools/release:defs.bzl", "artifact_image", "artifact_pkg_js")

npm_link_all_packages(name = "node_modules")

# tsc type-checks the bin-tree copies of srcs; the nearest package.json for
# format detection must therefore also be a bin-tree input declaring
# "type": "module" (NodeNext per-file ESM detection), hence the deps entry.
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["package.json"],
)

# TS types for the proto-loader runtime, cross-referencing the app-root proto
# target (same shape as the demo's //experimental/dsh/demo:chat_types and the
# agent v1 game_types precedent). The proto_library / go_proto_library /
# go_library targets live in //projects/game (specs/049-agent-v2-dsh-init/
# research.md D12).
ts_proto_library(
    name = "agent_v2_types",
    proto = "//projects/game:agent_v2_proto",
    visibility = ["//visibility:public"],
)

js_library(
    name = "agent_v2_types_lib",
    srcs = [":agent_v2_types"],
)

ts_project(
    name = "server_lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["**/*.test.ts"],
    ),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig",
    deps = [
        ":agent_v2_types_lib",
        ":node_modules/@deepseek-ai/dsh-agent",
        ":node_modules/@deepseek-ai/dsh-app-boot",
        ":node_modules/@deepseek-ai/dsh-llm",
        # The system-prompt read face (src/system-prompt.ts) imports
        # assembleContextFor + renderPrompt at runtime for GetTeamMember.
        ":node_modules/@deepseek-ai/dsh-system-prompt",
        ":node_modules/@dominion/common-js-bootstrap",
        ":node_modules/@dominion/common-js-constants",
        ":node_modules/@dominion/common-js-grpc-otel",
        ":node_modules/@dominion/common-js-grpc-resolver",
        ":node_modules/@dominion/common-js-logs",
        ":node_modules/@dominion/common-js-otel",
        ":node_modules/@dominion/common-js-resolver",
        # The preset domain face the server/session layers consume:
        # PresetAuthoringError for the gRPC status mapping, the
        # PresetAuthoringService typing behind ctx.presetAuthoring, and the
        # compose() wiring types (specs/059-agent-v2-team-mode/contracts/
        # preset-api.md).
        ":node_modules/@dominion/dsh-preset-authoring",
        # Type-only imports: the bridge handlers face and the loop plugin's
        # GameRuntime builder types. The runtime link targets enter through
        # :server_pkg runtime_deps.
        ":node_modules/@dominion/dsh-desktop-bridge",
        ":node_modules/@dominion/dsh-llm-glm",
        ":node_modules/@dominion/dsh-saolei-loop",
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
        ":node_modules/@types/node",
    ],
)

# Module format: Node determines the format of the deployed `.js` files
# from the nearest package.json. artifact_pkg_js's package_json attribute
# (default: this BUILD package's package.json) ships the service manifest
# at dominion/game/agent_v2/package.json, so the tar always carries it;
# package.json must not also be listed in data_files (destination conflict,
# specs/048-js-esm-migration/contracts/esm-package-conventions.md §4).
artifact_pkg_js(
    name = "server_pkg",
    app = "game",
    data_files = [
        "cordis.yml",
    ] + glob(
        # Template presets ship with the artifact under
        # /dominion/game/agent_v2/preset-templates (PRESET_TEMPLATES_ROOT —
        # the roster's system roots scan presets-templates/{player,planner},
        # specs/059-agent-v2-team-mode/contracts/dsh-plugins.md §5; demo
        # precedent: experimental/dsh/demo/agent/BUILD.bazel data_files).
        ["preset-templates/**"],
    ),
    entrypoint = "src/bootstrap.js",
    npm_deps = [
        # Service-declared dsh rows and imports (closure contract: the
        # manifest rows must be physically present for the Loader, and
        # boot/agent/llm are imported by src/*.ts). The framework-core rows
        # (timer/invariants + the cordis loader stack) enter through
        # @dominion/dsh-core in runtime_deps; the remaining direct-composed
        # dsh rows are declared here
        # (specs/059-agent-v2-team-mode/contracts/dsh-plugins.md §5).
        # system-prompt is both a framework-core row and the
        # src/system-prompt.ts GetTeamMember import, so it is declared too.
        # dsh-persona has no host row either — the preset compositions'
        # persona row resolves by bare package name from the host base
        # (roster README "How a preset's rows resolve").
        #
        # npm_deps carries THIRD-PARTY link targets only. The workspace
        # packages (@dominion/dsh-llm-glm, the saolei plugin set, team,
        # memory, memory-service, preset-authoring) enter exclusively through
        # runtime_deps (…:runtime_pkg): their link targets must NOT appear
        # here — npm_deps link targets carry real files only for registry
        # packages, and the Phase-3 staging deleted the manifest-less linker
        # store's package.json/.d.ts on the shared node_modules path (the
        # runtime crash "Cannot find package … @dominion/dsh-llm-glm"; the
        # healthy precedent is the common-js-* packages: runtime_deps only).
        ":node_modules/@deepseek-ai/dsh-agent",
        ":node_modules/@deepseek-ai/dsh-agent-loop",
        ":node_modules/@deepseek-ai/dsh-agent-presets",
        ":node_modules/@deepseek-ai/dsh-app-boot",
        ":node_modules/@deepseek-ai/dsh-llm",
        ":node_modules/@deepseek-ai/dsh-llm-retry",
        ":node_modules/@deepseek-ai/dsh-persona",
        ":node_modules/@deepseek-ai/dsh-scope",
        ":node_modules/@deepseek-ai/dsh-session",
        ":node_modules/@deepseek-ai/dsh-system-prompt",
        ":node_modules/@deepseek-ai/dsh-tools",
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
    ],
    runtime_protos = [
        "//projects/game:agent_v2_proto",
    ],
    # The discovery-plane service name (image metadata / deploy validation) —
    # hyphens per specs/049-agent-v2-dsh-init/research.md D13; the directory
    # and bazel target names keep agent_v2.
    service = "agent-v2",
    ts_project = ":server_lib",
    runtime_deps = [
        "//common/js/bootstrap:runtime_pkg",
        "//common/js/constants:runtime_pkg",
        # The composed rows and the preset-mounted plugin packages resolve by
        # bare name from this service's node_modules — the workspace packages
        # ship through runtime_deps (npm_deps is a no-op for them).
        "//common/js/dsh-plugins/desktop-bridge:runtime_pkg",
        "//common/js/dsh-plugins/llm-glm:runtime_pkg",
        "//common/js/dsh-plugins/llm-opencode-go:runtime_pkg",
        "//common/js/dsh-plugins/memory:runtime_pkg",
        "//common/js/dsh-plugins/memory-service:runtime_pkg",
        "//common/js/dsh-plugins/preset-authoring:runtime_pkg",
        "//common/js/dsh-plugins/saolei:runtime_pkg",
        "//common/js/dsh-plugins/saolei-loop:runtime_pkg",
        "//common/js/dsh-plugins/team:runtime_pkg",
        "//common/js/grpc/otel:runtime_pkg",
        "//common/js/grpc/resolver:runtime_pkg",
        "//common/js/logs:runtime_pkg",
        "//common/js/otel:runtime_pkg",
        "//common/js/resolver:runtime_pkg",
        "//third_party/dsh/core:runtime_pkg",
    ],
)

artifact_image(
    name = "cmd_image",
    app = "game",
    pkg = ":server_pkg",
    service = "agent-v2",
    visibility = ["//visibility:public"],
)

# Tests run against the raw .ts sources through vitest's single Vite pipeline
# (style/javascript.md data rules): production + test sources only, plus the
# node_modules mirror of :server_lib's deps, the runtime imports the tests
# exercise (the authoring error class, the game-runtime builder, cordis for
# the session-test scope harness), and the test-only imports (js-yaml for the
# manifest assertions). :agent_v2_types_lib is absent — the sources reference
# the generated proto types via `import type` only, which vitest erases at
# transform time. cordis.yml and the preset template data travel as data: the
# manifest tests assert the composition contract against the shipped file.
vitest_test(
    name = "lib_test",
    size = "small",
    data = glob(
        ["src/**/*.ts"],
        allow_empty = True,
    ) + glob(
        ["preset-templates/**"],
        allow_empty = True,
    ) + [
        "cordis.yml",
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-agent",
        ":node_modules/@deepseek-ai/dsh-app-boot",
        ":node_modules/@deepseek-ai/dsh-llm",
        ":node_modules/@deepseek-ai/dsh-system-prompt",
        ":node_modules/@dominion/common-js-bootstrap",
        ":node_modules/@dominion/common-js-constants",
        ":node_modules/@dominion/common-js-grpc-otel",
        ":node_modules/@dominion/common-js-grpc-resolver",
        ":node_modules/@dominion/common-js-logs",
        ":node_modules/@dominion/common-js-otel",
        ":node_modules/@dominion/common-js-resolver",
        ":node_modules/@dominion/dsh-llm-glm",
        ":node_modules/@dominion/dsh-preset-authoring",
        ":node_modules/@dominion/dsh-saolei-loop",
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
        ":node_modules/@types/node",
        ":node_modules/js-yaml",
    ],
)
