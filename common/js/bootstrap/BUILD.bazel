load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")
load("//tools/release:js_runtime_library.bzl", "js_runtime_library")

npm_link_all_packages(name = "node_modules")

# tsc type-checks the bin-tree copies of srcs; the nearest package.json for
# format detection must therefore also be a bin-tree input declaring
# "type": "module" (NodeNext per-file ESM detection), hence the deps entry.
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["package.json"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["**/*.test.ts"],
    ),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@dominion/common-js-logs",
        ":node_modules/@types/node",
    ],
)

# Workspace package target required by npm_link_all_packages for workspace:* deps.
# package.json is required here so that the npm linker populates the virtual
# store entry with the package manifest — without it, downstream js_test
# targets cannot resolve this package via require().
js_library(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    visibility = ["//visibility:public"],
)

# Runtime package target exposing JsRuntimePackageInfo for artifact_pkg_js
# runtime_deps closure walking. Separate from :pkg because npm_link_all_packages
# requires JsInfo provider which only js_library provides.
js_runtime_library(
    name = "runtime_pkg",
    package_name = "@dominion/common-js-bootstrap",
    lib = ":lib",
    npm_deps = [],
    package_json = "package.json",
    visibility = ["//visibility:public"],
    runtime_deps = [
        "//common/js/logs:runtime_pkg",
    ],
)

vitest_test(
    name = "lib_test",
    size = "small",
    # Tests run against the package's raw .ts sources (NOT the compiled :lib):
    # having compiled output alongside sources resolves the same file as two
    # module instances, breaking instanceof checks and module-level singletons.
    # External npm packages ship no .ts sources, so mirroring :lib's
    # node_modules deps here does not re-create that dual instance.
    # See the tools/dev/js/vitest_test.bzl docstring and
    # specs/019-js-test-reliability/research.md §6.
    data = glob(
        ["src/**/*.ts"],
        allow_empty = True,
    ) + [
        ":node_modules/@dominion/common-js-logs",
        ":node_modules/@types/node",
    ],
)
