load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")
load("//tools/release:js_runtime_library.bzl", "js_runtime_library")

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "lib",
    srcs = glob(["src/**/*.ts"]),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig.json",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@types/node",
        ":node_modules/js-yaml",
    ],
)

# Workspace package target required by npm_link_all_packages for workspace:* deps.
# package.json is required here so that the npm linker populates the virtual
# store entry with the package manifest — without it, downstream js_test
# targets cannot resolve this package via require().
js_library(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    visibility = ["//visibility:public"],
)

# Runtime package target exposing JsRuntimePackageInfo for artifact_pkg_js
# runtime_deps closure walking. Separate from :pkg because npm_link_all_packages
# requires JsInfo provider which only js_library provides.
js_runtime_library(
    name = "runtime_pkg",
    package_name = "@dominion/common-js-config",
    lib = ":lib",
    npm_deps = [
        ":node_modules/js-yaml",
    ],
    package_json = "package.json",
    visibility = ["//visibility:public"],
    runtime_deps = [],
)

vitest_test(
    name = "lib_test",
    size = "small",
    # Fix B: test against the package's raw .ts source (NOT the compiled :lib).
    # The node_modules mirror the :lib deps (dropping :lib removed their
    # transitive runfiles carry-in); external npm packages have no .ts source in
    # runfiles, so adding them does NOT re-create the dual instance.
    # See tools/dev/js/vitest_test.bzl docstring +
    # specs/019-js-test-reliability/research.md §6.
    data = glob(
        ["src/**/*.ts"],
        allow_empty = True,
    ) + glob(
        ["test/**/*.ts"],
        allow_empty = True,
    ) + [
        ":node_modules/js-yaml",
        ":node_modules/@types/node",
    ],
    # Tests live in test/ (not src/), so the vitest filter defaults
    # ["run", "src/"] would match nothing.
    args = ["run", "test/"],
)
