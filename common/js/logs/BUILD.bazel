load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/release:js_runtime_library.bzl", "js_runtime_library")

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["**/*.test.ts"],
    ),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig.json",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@opentelemetry/api",
        ":node_modules/@opentelemetry/api-logs",
        ":node_modules/@types/node",
    ],
)

# Workspace package target required by npm_link_all_packages for workspace:* deps.
# package.json is required here so that the npm linker populates the virtual
# store entry with the package manifest — without it, downstream js_test
# targets cannot resolve this package via require().
js_library(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    visibility = ["//visibility:public"],
)

# Runtime package target exposing JsRuntimePackageInfo for artifact_pkg_js
# runtime_deps closure walking. Separate from :pkg because npm_link_all_packages
# requires JsInfo provider which only js_library provides.
js_runtime_library(
    name = "runtime_pkg",
    package_name = "@dominion/common-js-logs",
    lib = ":lib",
    npm_deps = [
        ":node_modules/@opentelemetry/api",
        ":node_modules/@opentelemetry/api-logs",
    ],
    package_json = "package.json",
    visibility = ["//visibility:public"],
    runtime_deps = [],
)

# Small bootstrap script that invokes vitest programmatically.
# vitest.mjs is a bin file not exposed by npm_link_all_packages,
# so we use vitest's programmatic API instead.
js_test(
    name = "lib_test",
    size = "small",
    args = [
        "run",
        "src/",
    ],
    data = [
        ":lib",
        ":node_modules/vitest",
    ] + glob(
        ["src/**/*.test.ts"],
        allow_empty = True,
    ),
    entry_point = "run_vitest.mjs",
)
