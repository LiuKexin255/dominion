load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")
load("//tools/release:js_runtime_library.bzl", "js_runtime_library")

npm_link_all_packages(name = "node_modules")

# tsc type-checks the bin-tree copies of srcs; the nearest package.json for
# format detection must therefore also be a bin-tree input declaring
# "type": "module" (NodeNext per-file ESM detection), hence the deps entry.
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["package.json"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["**/*.test.ts"],
    ),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-agent-presets",
        ":node_modules/@deepseek-ai/schemastery",
        ":node_modules/@types/node",
        ":node_modules/js-yaml",
    ],
)

# Workspace package target required by npm_link_all_packages for workspace:*
# deps (common/js/dsh-plugins/llm-glm/BUILD.bazel precedent).
#
# "package.json" in srcs is REQUIRED for the npm-linker's runfiles store
# entry of a workspace package: the entry is populated from the js_library
# srcs, and without the manifest in it, Node cannot resolve the bare
# specifier (no package.json to read exports/main from). This demo-adjacent
# plugin is loaded through exactly that surface — the composition
# integration test boots the real cordis.yml whose Loader imports the row
# by bare name — so omitting it fails the test with "Cannot find package
# @dominion/dsh-preset-authoring" (common/js/bootstrap/BUILD.bazel
# precedent).
#
# This does NOT revive the assumption llm-glm's comment disproved: that
# disproof concerns the PACKAGING face — the manifest shipped in the
# artifact tar is staged by artifact_pkg_js from js_runtime_library's
# package_json regardless of this srcs entry, so adding it here changes
# nothing about what ships. The two conclusions hold on different faces:
# packaging needs nothing here, vitest/Loader resolution needs the manifest.
js_library(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    visibility = ["//visibility:public"],
)

# Runtime package target exposing JsRuntimePackageInfo for artifact_pkg_js
# runtime_deps closure walking. npm_deps carries the plugin's runtime
# imports: the roster seam types/values (dsh-agent-presets), the Config
# schema (schemastery), and the composition-file patcher (js-yaml)
# (specs/058-dsh-preset-roster-demo/contracts/composition-manifest.md §4).
js_runtime_library(
    name = "runtime_pkg",
    package_name = "@dominion/dsh-preset-authoring",
    lib = ":lib",
    npm_deps = [
        ":node_modules/@deepseek-ai/dsh-agent-presets",
        ":node_modules/@deepseek-ai/schemastery",
        ":node_modules/js-yaml",
    ],
    package_json = "package.json",
    visibility = ["//visibility:public"],
    runtime_deps = [],
)

# Tests run against the raw .ts sources through vitest's single Vite pipeline
# (style/javascript.md data rules): production + test sources only, plus the
# node_modules mirror of :lib's deps.
vitest_test(
    name = "lib_test",
    size = "small",
    data = glob(
        ["src/**/*.ts"],
        allow_empty = True,
    ) + [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-agent-presets",
        ":node_modules/@deepseek-ai/schemastery",
        ":node_modules/@types/node",
        ":node_modules/js-yaml",
    ],
)
