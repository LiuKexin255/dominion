load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")
load("//tools/release:js_runtime_library.bzl", "js_runtime_library")

npm_link_all_packages(name = "node_modules")

# tsc type-checks the bin-tree copies of srcs; the nearest package.json for
# format detection must therefore also be a bin-tree input declaring
# "type": "module" (NodeNext per-file ESM detection), hence the deps entry.
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["package.json"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["**/*.test.ts"],
    ),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-system-prompt",
        ":node_modules/@deepseek-ai/dsh-tools",
        ":node_modules/@dominion/dsh-memory-service",
        ":node_modules/@types/node",
    ],
)

# "package.json" in srcs is REQUIRED for the npm-linker's runfiles store
# entry of a workspace package: the entry is populated from the js_library
# srcs, and without the manifest in it, Node cannot resolve the bare
# specifier (no package.json to read exports/main from). The planner pool's
# template preset mounts this package's tool row by bare name, so omitting it
# fails with "Cannot find package @dominion/dsh-memory"
# (common/js/dsh-plugins/preset-authoring/BUILD.bazel precedent).
js_library(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    visibility = ["//visibility:public"],
)

# Runtime package target exposing JsRuntimePackageInfo for artifact_pkg_js
# runtime_deps closure walking. npm_deps carries the plugin's runtime import:
# the tool definition helper (dsh-tools). The memory service face this row
# injects by name is a workspace package, so it enters through runtime_deps
# below (npm_deps link targets carry registry packages only).
js_runtime_library(
    name = "runtime_pkg",
    package_name = "@dominion/dsh-memory",
    lib = ":lib",
    npm_deps = [
        ":node_modules/@deepseek-ai/dsh-tools",
    ],
    package_json = "package.json",
    visibility = ["//visibility:public"],
    runtime_deps = [
        "//common/js/dsh-plugins/memory-service:runtime_pkg",
    ],
)

# Tests run against the raw .ts sources through vitest's single Vite pipeline
# (style/javascript.md data rules): production + test sources only, plus the
# node_modules mirror of :lib's deps.
vitest_test(
    name = "lib_test",
    size = "small",
    data = glob(
        ["src/**/*.ts"],
        allow_empty = True,
    ) + [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-system-prompt",
        ":node_modules/@deepseek-ai/dsh-tools",
        ":node_modules/@dominion/dsh-memory-service",
        ":node_modules/@types/node",
    ],
)
