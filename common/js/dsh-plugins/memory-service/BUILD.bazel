load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")
load("//tools/release:js_runtime_library.bzl", "js_runtime_library")

npm_link_all_packages(name = "node_modules")

# tsc type-checks the bin-tree copies of srcs; the nearest package.json for
# format detection must therefore also be a bin-tree input declaring
# "type": "module" (NodeNext per-file ESM detection), hence the deps entry.
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["package.json"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["**/*.test.ts"],
    ),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-agent",
        ":node_modules/@deepseek-ai/dsh-scope",
        ":node_modules/@dominion/common-js-grpc-resolver",
        ":node_modules/@dominion/common-js-logs",
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
        ":node_modules/@types/node",
    ],
)

# "package.json" in srcs is REQUIRED for the npm-linker's runfiles store
# entry of a workspace package: the entry is populated from the js_library
# srcs, and without the manifest in it, Node cannot resolve the bare
# specifier (no package.json to read exports/main from). The agent_v2 host
# composition imports the host row by bare name
# (specs/064-memory-split-fold-remain/contracts/dsh-plugins.md §3), so
# omitting it fails with "Cannot find package @dominion/dsh-memory-service"
# (common/js/dsh-plugins/preset-authoring/BUILD.bazel precedent).
js_library(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    visibility = ["//visibility:public"],
)

# Runtime package target exposing JsRuntimePackageInfo for artifact_pkg_js
# runtime_deps closure walking. npm_deps carries the plugin's runtime imports:
# the memory-service gRPC client (grpc-js + proto-loader). cordis/dsh-agent/
# dsh-scope are type-only faces and resolve from the host composition.
# runtime_deps carries the workspace packages the client consumes (the
# dominion resolver and the logs face).
js_runtime_library(
    name = "runtime_pkg",
    package_name = "@dominion/dsh-memory-service",
    lib = ":lib",
    npm_deps = [
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
    ],
    package_json = "package.json",
    visibility = ["//visibility:public"],
    runtime_deps = [
        "//common/js/grpc/resolver:runtime_pkg",
        "//common/js/logs:runtime_pkg",
    ],
)

# Tests run against the raw .ts sources through vitest's single Vite pipeline
# (style/javascript.md data rules): production + test sources only, plus the
# node_modules mirror of :lib's deps.
vitest_test(
    name = "lib_test",
    size = "small",
    data = glob(
        ["src/**/*.ts"],
        allow_empty = True,
    ) + [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-agent",
        ":node_modules/@deepseek-ai/dsh-scope",
        ":node_modules/@dominion/common-js-grpc-resolver",
        ":node_modules/@dominion/common-js-logs",
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
        ":node_modules/@types/node",
    ],
)
