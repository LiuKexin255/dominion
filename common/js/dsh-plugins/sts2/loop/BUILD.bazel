load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")
load("//tools/release:js_runtime_library.bzl", "js_runtime_library")

npm_link_all_packages(name = "node_modules")

# tsc type-checks the bin-tree copies of srcs; the nearest package.json for
# format detection must therefore also be a bin-tree input declaring
# "type": "module" (NodeNext per-file ESM detection), hence the deps entry.
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["package.json"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["**/*.test.ts"],
    ),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-agent",
        ":node_modules/@deepseek-ai/dsh-llm",
        ":node_modules/@dominion/dsh-team",
        ":node_modules/@types/node",
    ],
)

# Workspace package target required by npm_link_all_packages for workspace:*
# deps. "package.json" in srcs populates the npm-linker's runfiles store entry
# with the manifest — the composition mounts this package as its lazy
# `sts2-loop` row resolved by bare specifier, so without the manifest in srcs
# that resolution fails with "Cannot find package @dominion/dsh-sts2-loop"
# (common/js/dsh-plugins/sts2/game/BUILD.bazel precedent).
js_library(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    visibility = ["//visibility:public"],
)

# Runtime package target exposing JsRuntimePackageInfo for artifact_pkg_js
# runtime_deps closure walking (common/js/dsh-plugins/llm-glm/BUILD.bazel
# precedent). npm_deps carries the plugin's only runtime import: the dsh-llm
# user-message helper the orchestrator builds seam input with. The dsh-agent
# and cordis faces are type-only (the host composition provides their runtime),
# and @dominion/dsh-team is a type-only import, so the deployed closure ships
# this package plus dsh-llm
# (specs/080-host-main-sub-model/contracts/sts2-loop-minimal.md §2/§3;
# specs/079-sts2-template-scaffold/contracts/dsh-plugins-layout.md §4).
js_runtime_library(
    name = "runtime_pkg",
    package_name = "@dominion/dsh-sts2-loop",
    lib = ":lib",
    npm_deps = [
        ":node_modules/@deepseek-ai/dsh-llm",
    ],
    package_json = "package.json",
    visibility = ["//visibility:public"],
)

# Tests run against the raw .ts sources through vitest's single Vite pipeline
# (style/javascript.md data rules): production + test sources only, plus the
# node_modules mirror of :lib's deps.
vitest_test(
    name = "lib_test",
    size = "small",
    data = glob(
        ["src/**/*.ts"],
        allow_empty = True,
    ) + [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-agent",
        ":node_modules/@deepseek-ai/dsh-llm",
        ":node_modules/@dominion/dsh-team",
        ":node_modules/@types/node",
    ],
)
