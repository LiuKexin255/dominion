load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")
load("//tools/release:js_runtime_library.bzl", "js_runtime_library")

npm_link_all_packages(name = "node_modules")

# tsc type-checks the bin-tree copies of srcs; the nearest package.json for
# format detection must therefore also be a bin-tree input declaring
# "type": "module" (NodeNext per-file ESM detection), hence the deps entry.
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["package.json"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["**/*.test.ts"],
    ),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-llm",
        ":node_modules/@deepseek-ai/dsh-timeout",
        ":node_modules/@deepseek-ai/schemastery",
        ":node_modules/@types/node",
        ":node_modules/eventsource-parser",
    ],
)

# Workspace package target required by npm_link_all_packages for workspace:*
# deps. The manifest is deliberately NOT a js_library src — valid HERE
# because llm-glm has no bare-name resolution consumer: the tar's manifest
# is staged by artifact_pkg_js Phase 4 from js_runtime_library's
# package_json (packaging face), and nothing resolves this package by bare
# name against the runfiles store (resolution face).
#
# Precision (aspect_rules_js v3.0.3 linker): the pnpm workspace scan
# carries only name/version metadata — a workspace package's
# npm_package_store entry is a symlink to the `:pkg` js_library output — so
# on the RESOLUTION face the manifest file must come from srcs. That is why
# common/js/dsh-plugins/preset-authoring and
# experimental/dsh/demo/agent-plugins/demo-echo (whose rows the composition
# boot test imports by bare name) DO declare package.json. The Phase-1
# disproof of "the linker needs it in srcs" concerned the packaging face
# and stands: the runtime crash back then was the service BUILD's npm_deps
# duplication, not this declaration.
js_library(
    name = "pkg",
    srcs = [":lib"],
    visibility = ["//visibility:public"],
)

# Runtime package target exposing JsRuntimePackageInfo for artifact_pkg_js
# runtime_deps closure walking (common/js/otel/BUILD.bazel precedent).
# Separate from :pkg because npm_link_all_packages requires JsInfo provider
# which only js_library provides.
js_runtime_library(
    name = "runtime_pkg",
    package_name = "@dominion/dsh-llm-glm",
    lib = ":lib",
    npm_deps = [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-llm",
        ":node_modules/@deepseek-ai/dsh-timeout",
        ":node_modules/@deepseek-ai/schemastery",
        ":node_modules/eventsource-parser",
    ],
    package_json = "package.json",
    visibility = ["//visibility:public"],
    runtime_deps = [],
)

# Tests run against the raw .ts sources through vitest's single Vite pipeline
# (style/javascript.md data rules): production + test sources only, plus the
# node_modules mirror of :lib's deps.
vitest_test(
    name = "lib_test",
    size = "small",
    data = glob(
        ["src/**/*.ts"],
        allow_empty = True,
    ) + [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-llm",
        ":node_modules/@deepseek-ai/dsh-timeout",
        ":node_modules/@deepseek-ai/schemastery",
        ":node_modules/@types/node",
        ":node_modules/eventsource-parser",
    ],
)
