load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")
load("//tools/release:js_runtime_library.bzl", "js_runtime_library")

npm_link_all_packages(name = "node_modules")

# tsc type-checks the bin-tree copies of srcs; the nearest package.json for
# format detection must therefore also be a bin-tree input declaring
# "type": "module" (NodeNext per-file ESM detection), hence the deps entry.
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["package.json"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["**/*.test.ts"],
    ),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@dominion/common-js-grpc-resolver",
        ":node_modules/@dominion/common-js-logs",
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
        ":node_modules/@types/node",
    ],
)

# Workspace package target required by npm_link_all_packages for workspace:*
# deps. "package.json" in srcs populates the npm-linker's runfiles store entry
# with the manifest — without it a bare-specifier resolution at runtime fails
# ("Cannot find package @dominion/dsh-grpc-runtime"; common/js/dsh-plugins/
# memory-service/BUILD.bazel precedent).
js_library(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    visibility = ["//visibility:public"],
)

# Runtime package target exposing JsRuntimePackageInfo for artifact_pkg_js
# runtime_deps closure walking. npm_deps carries the third-party runtime
# imports (grpc-js + proto-loader); runtime_deps carries the workspace
# packages the runtime composes: the dominion resolver, which apply registers
# (specs/074-dsh-grpc-runtime/contracts/grpc-runtime.md §1), and the gRPC OTel
# instrumentation assembly, a deployment-closure dependency only — sources do
# not import it; the service bootstrap registers it through init()
# (specs/048-js-esm-migration/contracts/otel-instrumentation-esm-contract.md
# §2) — plus the logs face.
js_runtime_library(
    name = "runtime_pkg",
    package_name = "@dominion/dsh-grpc-runtime",
    lib = ":lib",
    npm_deps = [
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
    ],
    package_json = "package.json",
    visibility = ["//visibility:public"],
    runtime_deps = [
        "//common/js/grpc/otel:runtime_pkg",
        "//common/js/grpc/resolver:runtime_pkg",
        "//common/js/logs:runtime_pkg",
    ],
)

# Tests run against the raw .ts sources through vitest's single Vite pipeline
# (style/javascript.md data rules): production + test sources only, plus the
# node_modules mirror of :lib's deps.
vitest_test(
    name = "lib_test",
    size = "small",
    data = glob(
        ["src/**/*.ts"],
        allow_empty = True,
    ) + [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@dominion/common-js-grpc-resolver",
        ":node_modules/@dominion/common-js-logs",
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
        ":node_modules/@types/node",
    ],
)
