load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")
load("//tools/release:js_runtime_library.bzl", "js_runtime_library")

npm_link_all_packages(name = "node_modules")

# tsc type-checks the bin-tree copies of srcs; the nearest package.json for
# format detection must therefore also be a bin-tree input declaring
# "type": "module" (NodeNext per-file ESM detection), hence the deps entry.
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["package.json"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["**/*.test.ts"],
    ),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@dominion/dsh-saolei",
        ":node_modules/@types/node",
    ],
)

# Workspace package target required by npm_link_all_packages for workspace:*
# deps. "package.json" in srcs populates the npm-linker's runfiles store entry
# with the manifest — without it a bare-specifier resolution at runtime fails
# ("Cannot find package @dominion/dsh-saolei-hooks"; common/js/dsh-plugins/
# saolei-memory/BUILD.bazel precedent). The composition mounts this package as
# a saolei-loop `config.plugins` sub-plugin resolved by bare name.
js_library(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    visibility = ["//visibility:public"],
)

# Runtime package target exposing JsRuntimePackageInfo for artifact_pkg_js
# runtime_deps closure walking (common/js/dsh-plugins/saolei-tools/BUILD.bazel
# precedent). npm_deps carries the third-party packages the plugin touches at
# runtime: the tool-definition helper (dsh-tools) plus the two peer faces the
# plugin entry and the hooks unit resolve from the host composition (cordis
# context, dsh-system-prompt section types). The workspace dependency
# @dominion/dsh-saolei is type-only here (GameState/GameLogEntry resolve to
# erased `import type`), so it does not enter this package's runtime closure —
# the game runtime is provided by the orchestration through the agent-scoped
# `saoleiGame` handle.
js_runtime_library(
    name = "runtime_pkg",
    package_name = "@dominion/dsh-saolei-hooks",
    lib = ":lib",
    npm_deps = [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-system-prompt",
        ":node_modules/@deepseek-ai/dsh-tools",
    ],
    package_json = "package.json",
    visibility = ["//visibility:public"],
)

# Tests run against the raw .ts sources through vitest's single Vite pipeline
# (style/javascript.md data rules): production + test sources only, plus the
# node_modules mirror of :lib's deps.
vitest_test(
    name = "lib_test",
    size = "small",
    data = glob(
        ["src/**/*.ts"],
        allow_empty = True,
    ) + [
        ":node_modules/@dominion/dsh-saolei",
        ":node_modules/@types/node",
    ],
)
