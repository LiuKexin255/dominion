load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")
load("//tools/release:js_runtime_library.bzl", "js_runtime_library")

npm_link_all_packages(name = "node_modules")

# tsc type-checks the bin-tree copies of srcs; the nearest package.json for
# format detection must therefore also be a bin-tree input declaring
# "type": "module" (NodeNext per-file ESM detection), hence the deps entry.
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["package.json"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["**/*.test.ts"],
    ),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-agent",
        ":node_modules/@deepseek-ai/dsh-llm",
        ":node_modules/@deepseek-ai/dsh-session",
        ":node_modules/@dominion/dsh-desktop-bridge",
        ":node_modules/@dominion/dsh-team",
        ":node_modules/@dominion/game-saolei-board",
        ":node_modules/@types/node",
    ],
)

# Workspace package target required by npm_link_all_packages for workspace:*
# deps.
#
# "package.json" in srcs is REQUIRED for the npm-linker's runfiles store
# entry of a workspace package: the entry is populated from the js_library
# srcs, and without the manifest in it, Node cannot resolve the bare
# specifier. agent_v2's vitest runfiles runtime-import this package's
# createAgentGameRuntime (session.ts), so omitting it fails with
# "Cannot find package @dominion/dsh-saolei-loop"
# (common/js/dsh-plugins/preset-authoring/BUILD.bazel precedent). This does
# NOT change the packaging face: the shipped manifest is staged by
# artifact_pkg_js from js_runtime_library's package_json regardless.
js_library(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    visibility = ["//visibility:public"],
)

# Runtime package target exposing JsRuntimePackageInfo for artifact_pkg_js
# runtime_deps closure walking (common/js/dsh-plugins/llm-glm/BUILD.bazel
# precedent). npm_deps carries the plugin's runtime imports: the cordis
# Service base class (game/runtime.ts) and the dsh-llm message helpers
# (orchestrator.ts builds user messages; announcer.ts builds the announcement
# assistant message). The remaining dsh faces (dsh-agent, dsh-desktop-bridge,
# dsh-session) are type-only and resolve from the host composition;
# @dominion/dsh-team is a runtime workspace import (agentMemberSource in
# orchestrator.ts) and ships through runtime_deps.
js_runtime_library(
    name = "runtime_pkg",
    package_name = "@dominion/dsh-saolei-loop",
    lib = ":lib",
    npm_deps = [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-llm",
    ],
    package_json = "package.json",
    visibility = ["//visibility:public"],
    runtime_deps = [
        "//common/js/dsh-plugins/team:runtime_pkg",
        "//projects/game/pkg/saolei-board:runtime_pkg",
    ],
)

# Tests run against the raw .ts sources through vitest's single Vite pipeline
# (style/javascript.md data rules): production + test sources only, plus the
# node_modules mirror of :lib's deps and the test-only scope primitive the
# lifecycle harness mints agent scopes through.
vitest_test(
    name = "lib_test",
    size = "small",
    data = glob(
        ["src/**/*.ts"],
        allow_empty = True,
    ) + [
        ":node_modules/@deepseek-ai/cordis",
        ":node_modules/@deepseek-ai/dsh-agent",
        ":node_modules/@deepseek-ai/dsh-llm",
        ":node_modules/@deepseek-ai/dsh-scope",
        ":node_modules/@deepseek-ai/dsh-session",
        ":node_modules/@dominion/dsh-desktop-bridge",
        ":node_modules/@dominion/dsh-team",
        ":node_modules/@dominion/game-saolei-board",
        ":node_modules/@types/node",
    ],
)
