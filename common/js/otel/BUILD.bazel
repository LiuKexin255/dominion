load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/dev/js:vitest_test.bzl", "vitest_test")
load("//tools/release:js_runtime_library.bzl", "js_runtime_library")

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["**/*.test.ts"],
    ),
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig.json",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@opentelemetry/api",
        ":node_modules/@opentelemetry/api-logs",
        ":node_modules/@opentelemetry/exporter-logs-otlp-http",
        ":node_modules/@opentelemetry/exporter-metrics-otlp-http",
        ":node_modules/@opentelemetry/exporter-trace-otlp-http",
        ":node_modules/@opentelemetry/instrumentation",
        ":node_modules/@opentelemetry/resources",
        ":node_modules/@opentelemetry/sdk-logs",
        ":node_modules/@opentelemetry/sdk-metrics",
        ":node_modules/@opentelemetry/sdk-trace-base",
        ":node_modules/@opentelemetry/sdk-trace-node",
        ":node_modules/@opentelemetry/semantic-conventions",
        ":node_modules/@types/node",
    ],
)

# Workspace package target required by npm_link_all_packages for workspace:* deps.
js_library(
    name = "pkg",
    srcs = [":lib"],
    visibility = ["//visibility:public"],
)

# Runtime package target exposing JsRuntimePackageInfo for artifact_pkg_js
# runtime_deps closure walking. Separate from :pkg because npm_link_all_packages
# requires JsInfo provider which only js_library provides.
js_runtime_library(
    name = "runtime_pkg",
    package_name = "@dominion/common-js-otel",
    lib = ":lib",
    npm_deps = [
        ":node_modules/@opentelemetry/api",
        ":node_modules/@opentelemetry/api-logs",
        ":node_modules/@opentelemetry/exporter-logs-otlp-http",
        ":node_modules/@opentelemetry/exporter-metrics-otlp-http",
        ":node_modules/@opentelemetry/exporter-trace-otlp-http",
        ":node_modules/@opentelemetry/instrumentation",
        ":node_modules/@opentelemetry/resources",
        ":node_modules/@opentelemetry/sdk-logs",
        ":node_modules/@opentelemetry/sdk-metrics",
        ":node_modules/@opentelemetry/sdk-trace-base",
        ":node_modules/@opentelemetry/sdk-trace-node",
        ":node_modules/@opentelemetry/semantic-conventions",
    ],
    package_json = "package.json",
    visibility = ["//visibility:public"],
    runtime_deps = [],
)

vitest_test(
    name = "lib_test",
    size = "small",
    data = [
        "src/index.test.ts",
        ":lib",
    ],
)
