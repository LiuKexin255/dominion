load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/release:defs.bzl", "artifact_image", "artifact_pkg_go")

go_library(
    name = "gateway_lib",
    srcs = ["main.go"],
    importpath = "dominion/experimental/dsh/demo/gateway",
    visibility = ["//visibility:private"],
    deps = [
        "//common/gopkg/bootstrap",
        "//common/gopkg/grpc",
        "//common/gopkg/grpc/solver",
        "//common/gopkg/http",
        "//common/gopkg/otel",
        "//experimental/dsh/demo:chat",
        "@grpc_ecosystem_grpc_gateway//runtime",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "gateway",
    embed = [":gateway_lib"],
    visibility = ["//visibility:public"],
)

artifact_pkg_go(
    name = "service_pkg",
    app = "dsh-demo",
    binary = ":gateway",
    service = "gateway",
)

artifact_image(
    name = "cmd_image",
    app = "dsh-demo",
    pkg = ":service_pkg",
    service = "gateway",
    visibility = ["//visibility:public"],
)
