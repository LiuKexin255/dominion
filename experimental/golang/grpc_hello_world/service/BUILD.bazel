load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/release:defs.bzl", "artifact_image")

go_library(
    name = "service_lib",
    srcs = ["main.go"],
    importpath = "dominion/experimental/golang/grpc_hello_world/service",
    visibility = ["//visibility:private"],
    deps = [
        "//common/gopkg/grpc",
        "//experimental/golang/grpc_hello_world",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//reflection",
    ],
)

go_binary(
    name = "service",
    embed = [":service_lib"],
    visibility = ["//visibility:public"],
)

artifact_image(
    name = "cmd_image",
    app = "grpc-hello-world",
    binary = ":service",
    service = "service",
)
