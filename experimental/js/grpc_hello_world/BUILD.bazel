load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/dev/js:ts_proto_library.bzl", "ts_proto_library")
load("//tools/release:defs.bzl", "artifact_image", "artifact_pkg_js")

npm_link_all_packages(name = "node_modules")

# tsc type-checks the bin-tree copies of srcs; the nearest package.json for
# format detection must therefore also be a bin-tree input declaring
# "type": "module" (NodeNext per-file ESM detection), hence the deps entry.
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["package.json"],
)

proto_library(
    name = "greeter_proto",
    srcs = ["greeter.proto"],
    visibility = ["//visibility:public"],
    deps = ["@googleapis//google/api:annotations_proto"],
)

ts_proto_library(
    name = "greeter_types",
    proto = ":greeter_proto",
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "greeter_go_proto",
    compilers = [
        "@rules_go//proto:go_grpc_v2",
        "@rules_go//proto:go_proto",
        "@grpc_ecosystem_grpc_gateway//protoc-gen-grpc-gateway:go_gen_grpc_gateway",
        "//:go_gen_aip",
    ],
    importpath = "dominion/experimental/ts/grpc_hello_world",
    proto = ":greeter_proto",
    visibility = ["//visibility:public"],
    deps = ["@googleapis//google/api:annotations_go_proto"],
)

go_library(
    name = "grpc_hello_world_go",
    embed = [":greeter_go_proto"],
    importpath = "dominion/experimental/ts/grpc_hello_world",
    visibility = ["//visibility:public"],
)

ts_project(
    name = "server",
    srcs = [
        "src/bootstrap.ts",
        "src/server.ts",
    ],
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig",
    deps = [
        ":greeter_types_lib",
        ":node_modules/@dominion/common-js-config",
        ":node_modules/@dominion/common-js-grpc-otel",
        ":node_modules/@dominion/common-js-logs",
        ":node_modules/@dominion/common-js-otel",
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
        ":node_modules/@types/node",
    ],
)

js_library(
    name = "greeter_types_lib",
    srcs = [":greeter_types"],
)

# Package JS service files into a tar layer
artifact_pkg_js(
    name = "server_pkg",
    app = "grpc-hello-world-ts",
    entrypoint = "src/bootstrap.js",
    npm_deps = [
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
    ],
    runtime_protos = [
        ":greeter_proto",
    ],
    service = "service",
    ts_project = ":server",
    runtime_deps = [
        "//common/js/config:runtime_pkg",
        "//common/js/grpc/otel:runtime_pkg",
        "//common/js/logs:runtime_pkg",
        "//common/js/otel:runtime_pkg",
    ],
)

# OCI image for the TypeScript gRPC server
artifact_image(
    name = "cmd_image",
    app = "grpc-hello-world-ts",
    pkg = ":server_pkg",
    service = "service",
    visibility = ["//visibility:public"],
)

# Smoke test: verify packaged service tar has no MODULE_NOT_FOUND errors
sh_test(
    name = "smoke_test",
    srcs = ["smoke_test.sh"],
    args = ["$(location :server_pkg)"],
    data = [":server_pkg"],
    tags = ["local"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
