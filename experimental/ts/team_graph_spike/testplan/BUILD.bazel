load("//tools/dev/go:defs.bzl", "go_largetest")

# Named `testplan_test` (the gazelle default for this package) so gazelle does
# not re-generate a duplicate go_unittest from interface_test.go
# (style/large_test.md §测试用例). go_largetest is excluded from the default
# `bazel test` run and is executed only via the testplan skill
# (guitar run interface_test.yaml).
go_largetest(
    name = "testplan_test",
    size = "small",
    srcs = ["interface_test.go"],
    deps = [
        "//common/gopkg/otel/tracecontext",
        "//common/gopkg/testtool",
    ],
)
