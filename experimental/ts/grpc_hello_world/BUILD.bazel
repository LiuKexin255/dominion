load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//experimental/ts/grpc_hello_world:@grpc/proto-loader/package_json.bzl", proto_loader = "bin")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//tools/proto:ts_proto_library.bzl", "ts_proto_library")

npm_link_all_packages(name = "node_modules")

proto_loader.proto_loader_gen_types_binary(
    name = "proto_loader_tool",
    visibility = ["//visibility:public"],
)

proto_library(
    name = "greeter_proto",
    srcs = ["greeter.proto"],
    visibility = ["//visibility:public"],
)

ts_proto_library(
    name = "greeter_types",
    proto = ":greeter_proto",
    tool = ":proto_loader_tool",
    visibility = ["//visibility:public"],
)

proto_library(
    name = "annotations_fixture_proto",
    srcs = ["annotations_fixture.proto"],
    visibility = ["//visibility:public"],
    deps = ["@googleapis//google/api:annotations_proto"],
)

ts_proto_library(
    name = "annotations_fixture_types",
    proto = ":annotations_fixture_proto",
    tool = ":proto_loader_tool",
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "greeter_go_proto",
    compilers = [
        "@rules_go//proto:go_grpc_v2",
        "@rules_go//proto:go_proto",
        "@grpc_ecosystem_grpc_gateway//protoc-gen-grpc-gateway:go_gen_grpc_gateway",
    ],
    importpath = "dominion/experimental/ts/grpc_hello_world",
    proto = ":greeter_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "grpc_hello_world_go",
    embed = [":greeter_go_proto"],
    importpath = "dominion/experimental/ts/grpc_hello_world",
    visibility = ["//visibility:public"],
)

ts_project(
    name = "server",
    srcs = [
        "src/server.ts",
    ],
    declaration = True,
    transpiler = swc,
    tsconfig = ":tsconfig.json",
    deps = [
        ":greeter_types_lib",
        ":node_modules/@grpc/grpc-js",
        ":node_modules/@grpc/proto-loader",
        ":node_modules/@types/node",
    ],
)

js_library(
    name = "greeter_types_lib",
    srcs = [":greeter_types"],
)

js_binary(
    name = "run",
    data = [
        "greeter.proto",
        ":server",
    ],
    entry_point = "src/server.js",
)

# OCI image for the TypeScript gRPC server
genrule(
    name = "server_layer",
    srcs = [":server"],
    outs = ["server_layer.tar"],
    cmd = """
mkdir -p src
cp $(location :server) src/server.js
tar cf $@ src/server.js
""",
    visibility = ["//visibility:public"],
)

oci_image(
    name = "cmd_image",
    base = "@distroless_nodejs",
    cmd = ["src/server.js"],
    entrypoint = ["node"],
    tars = [":server_layer"],
    visibility = ["//visibility:public"],
)
