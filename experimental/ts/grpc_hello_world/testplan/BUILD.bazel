load("//tools/dev/go:defs.bzl", "go_largetest")
load("//tools/release:defs.bzl", "artifact_image", "artifact_pkg_go")

artifact_pkg_go(
    name = "service_pkg",
    app = "grpc-hello-world-ts",
    binary = "//experimental/ts/grpc_hello_world/testplan/gateway:gateway",
    service = "gateway",
)

artifact_image(
    name = "cmd_image",
    app = "grpc-hello-world-ts",
    pkg = ":service_pkg",
    service = "gateway",
)

go_largetest(
    name = "testplan_test",
    size = "small",
    srcs = ["interface_test.go"],
    deps = ["//common/gopkg/testtool"],
)

# health_test observes the self-heal path (SC-003): the selfheal suite's
# deploy injects HEALTH_STOP_AFTER_MS, and the case polls the public entry
# through "success → liveness-killed failure window → recovery"
# (specs/052-deploy-health-probe/contracts/verification-testplan.md §2).
# Compiled separately from testplan_test so the failure-window polling never
# runs in the default suite, where no failure would ever appear.
#
# size = large: the poll windows span up to ~6 min worst case (initial 60s +
# failure 150s + recovery 150s, health_test.go constants) — the 60s small
# budget cannot cover the minutes-scale kill+restart cycle.
go_largetest(
    name = "health_test",
    size = "large",
    srcs = ["health_test.go"],
    deps = [
        "//common/gopkg/otel/tracecontext",
        "//common/gopkg/testtool",
    ],
)
