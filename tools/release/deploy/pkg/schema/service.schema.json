{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Service",
  "type": "object",
  "description": "服务定义 schema",
  "additionalProperties": false,
  "required": [
    "name",
    "app",
    "desc",
    "artifacts"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "stateless",
        "stateful"
      ],
      "description": "工作负载类型，默认 stateless"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "服务名"
    },
    "app": {
      "type": "string",
      "minLength": 1,
      "description": "服务所属应用名"
    },
    "desc": {
      "type": "string",
      "minLength": 1,
      "description": "服务描述"
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "description": "服务配置资源标识"
    },
    "ports": {
      "type": "array",
      "description": "所有 artifact 共有的默认端口",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "port"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": "integer"
          }
        }
      }
    },
    "configs": {
      "type": "array",
      "description": "所有 artifact 共享的配置块定义池（非敏感数据）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "data"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "description": "配置块名"
          },
          "data": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "description": "原始数据文本（JSON 或 YAML），非 base64"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "json",
                    "yaml"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "description": "服务产物 target 列表，必须为 oci_image 对象，并且以 {artifact}_push 作为推送 target",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "target"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "产物别名，用于在部署配置中引用"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "bazel target 完整地址"
          },
          "tls": {
            "type": "boolean",
            "description": "是否为该产物启用 TLS，默认 false"
          },
          "oss": {
            "type": "boolean",
            "description": "是否为该产物启用 OSS，默认 false"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "http",
              "grpc"
            ],
            "description": "协议类型"
          },
          "ports": {
            "type": "array",
            "description": "服务对外暴露端口",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "port"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "integer"
                }
              }
            }
          },
          "secrets": {
            "type": "array",
            "description": "该产物运行时所需的 secret 逻辑名列表",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
