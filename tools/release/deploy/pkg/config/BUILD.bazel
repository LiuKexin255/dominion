load("@rules_go//go:def.bzl", "go_library")
load("//tools/dev/go:defs.bzl", "go_unittest")

go_library(
    name = "config",
    srcs = [
        "config.go",
        "v3.go",
    ],
    importpath = "dominion/tools/release/deploy/pkg/config",
    visibility = ["//visibility:public"],
    deps = [
        "//tools/release/deploy/pkg/schema",
        "//tools/release/deploy/pkg/workspace",
        "@com_github_goccy_go_yaml//:go-yaml",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@io_k8s_apimachinery//pkg/api/resource",
    ],
)

go_unittest(
    name = "config_test",
    srcs = [
        "config_test.go",
        "configs_test.go",
        "v3_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":config"],
)
