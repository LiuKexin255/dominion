{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "obs": {
        "type": "local",
        "command": ["/absolute/path/to/signoz-mcp-server"],
        "disabled": false,
        "timeout": {
          "catalog": 10000,
          "execution": 10000
        },
        "environment": {
          "SIGNOZ_URL": "<your-signoz-url>",
          "SIGNOZ_API_KEY": "<your-signoz-service-account-key>",
          "LOG_LEVEL": "info"
        }
      }
    }
  },
  "permissions": [
    { "action": "obs_*", "resource": "*", "effect": "deny" },

    // Optional read-only field discovery tools. Enable only when debugging
    // field mappings such as env -> deployment.environment.name.
    // { "action": "obs_signoz_get_field_keys", "resource": "*", "effect": "allow" },
    // { "action": "obs_signoz_get_field_values", "resource": "*", "effect": "allow" },

    { "action": "obs_signoz_search_logs", "resource": "*", "effect": "allow" },
    { "action": "obs_signoz_aggregate_logs", "resource": "*", "effect": "allow" },
    { "action": "obs_signoz_search_traces", "resource": "*", "effect": "allow" },
    { "action": "obs_signoz_aggregate_traces", "resource": "*", "effect": "allow" },
    { "action": "obs_signoz_get_trace_details", "resource": "*", "effect": "allow" }
  ]
}
