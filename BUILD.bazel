load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_go//proto:compiler.bzl", "go_proto_compiler")

# gazelle:prefix dominion
# gazelle:go_grpc_compilers @rules_go//proto:go_grpc_v2, @rules_go//proto:go_proto, @grpc_ecosystem_grpc_gateway//protoc-gen-grpc-gateway:go_gen_grpc_gateway, //:go_gen_aip
# gazelle:go_proto_compilers @rules_go//proto:go_proto, //:go_gen_aip
# gazelle:map_kind go_test go_unittest //tools/dev/go:defs.bzl
# gazelle:alias_kind go_largetest go_test

# gazelle:resolve proto google/api/annotations.proto @googleapis//google/api:annotations_proto
# gazelle:resolve proto google/api/http.proto @googleapis//google/api:http_proto
# gazelle:resolve proto google/api/field_behavior.proto @googleapis//google/api:field_behavior_proto
# gazelle:resolve proto google/api/resource.proto @googleapis//google/api:resource_proto
# gazelle:resolve proto google/api/client.proto @googleapis//google/api:client_proto
# gazelle:resolve proto google/protobuf/empty.proto @com_google_protobuf//:empty_proto
# gazelle:resolve proto google/protobuf/field_mask.proto @com_google_protobuf//:field_mask_proto
# gazelle:resolve proto google/protobuf/timestamp.proto @com_google_protobuf//:timestamp_proto

# gazelle:resolve proto go google/api/annotations.proto @googleapis//google/api:annotations_go_proto
# gazelle:resolve proto go google/api/http.proto @googleapis//google/api:http_go_proto
# gazelle:resolve proto go google/api/field_behavior.proto @googleapis//google/api:field_behavior_go_proto
# gazelle:resolve proto go google/api/resource.proto @googleapis//google/api:resource_go_proto
# gazelle:resolve proto go google/api/client.proto @googleapis//google/api:client_go_proto
# gazelle:resolve proto go google/protobuf/empty.proto @com_google_protobuf//:empty_go_proto
# gazelle:resolve proto go google/protobuf/field_mask.proto @com_google_protobuf//:field_mask_go_proto
# gazelle:resolve proto go google/protobuf/timestamp.proto @com_google_protobuf//:timestamp_go_proto

# gazelle:resolve go github.com/wailsapp/wails/v2 //third_party/github.com/wailsapp/wails/v2:wails
# gazelle:resolve go github.com/wailsapp/wails/v2/pkg/options //third_party/github.com/wailsapp/wails/v2/pkg/options
# gazelle:resolve go github.com/wailsapp/wails/v2/pkg/options/assetserver //third_party/github.com/wailsapp/wails/v2/pkg/options/assetserver
# gazelle:resolve go github.com/wailsapp/wails/v2/pkg/runtime //third_party/github.com/wailsapp/wails/v2/pkg/runtime

gazelle_binary(
    name = "gazelle_multilang",
    languages = [
        "@gazelle//language/proto",
        "@gazelle//language/go",
        "@rules_python_gazelle_plugin//python",
    ],
)

gazelle(
    name = "gazelle",
    extra_args = [
        "-index=lazy",
    ],
    gazelle = ":gazelle_multilang",
)

# go_gen_aip wraps protoc-contrib/protoc-gen-go-aip, generating type-safe
# resource-name parsers (e.g. ParseSessionName) from google.api.resource
# annotations. Applied to every go_proto_library via the go_grpc_compilers /
# go_proto_compilers directives above. Mirrors the grpc-gateway compiler
# precedent. The generated *_aip.pb.resource.go is self-contained (stdlib
# only); resource-less protos get a `// +build ignore` stub, so workspace-wide
# application is safe. Spike: experimental/golang/aip_codegen/FINDINGS.md.
go_proto_compiler(
    name = "go_gen_aip",
    plugin = "@com_github_protoc_contrib_protoc_gen_go_aip//cmd/protoc-gen-go-aip:protoc-gen-go-aip",
    suffix = "_aip.pb.resource.go",
    visibility = ["//visibility:public"],
)

# 生成 node_modules（运行时需要）
npm_link_all_packages()

alias(
    name = "deploy_install",
    actual = "//tools/release/deploy/v3:install",
)

alias(
    name = "guitar_install",
    actual = "//tools/test/guitar:install",
)

alias(
    name = "pnpm",
    actual = "//tools/dev/js:pnpm",
)

alias(
    name = "python",
    actual = "@rules_python//python/bin:python",
)

alias(
    name = "go",
    actual = "@rules_go//go",
)

exports_files([
    "gazelle_python.yaml",
    "pnpm-workspace.yaml",
    "requirements_lock.txt",
])
